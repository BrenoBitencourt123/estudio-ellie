# Planejamento: somente a ponte OpenClaw, com sua conta/assinatura configurada lá.
# O Estúdio v2 não pede OPENAI_API_KEY/ANTHROPIC_API_KEY nem troca para API paga.
OPENCLAW_AGENTE=ellie-studio
OPENCLAW_URL=ws://127.0.0.1:18789

# Caminho opcional da CLI oficial Dreamina; vazio usa PATH ou ~/bin.
DREAMINA_CLI=

# O código antigo Atlas foi preservado para compatibilidade; o novo chat usa Dreamina.
# Não são necessárias chaves Atlas para abrir o chat, editar e baixar os arquivos locais.
